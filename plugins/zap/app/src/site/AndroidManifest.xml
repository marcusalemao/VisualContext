<?xml version="1.0" encoding="utf-8"?>
<!-- Site build only: a phone launcher icon that opens Zap's settings. The Nexus
     registry build must not have one (lib-nexus-apk-verifier rejects MAIN/LAUNCHER). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity-alias
            android:name=".ZapLauncher"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".ZapSettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
