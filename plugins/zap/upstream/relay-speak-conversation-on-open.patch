+    /**
+     * Speaks the newest message of the conversation just opened.
+     *
+     * The text is the same one the reader shows, so a voice note arrives as
+     * its transcript whenever the source app supplied one. The wearer is
+     * looking at the conversation they chose, so the band's "sender only"
+     * rule does not apply here, as it does not apply to reading the thread.
+     */
+    private fun readOpenedThreadAloud() {
+        if (!settings.readThreadOnOpen()) return
+        val snapshot = currentEntry()?.snapshot ?: return
+        val text = RelayReadAloud.textFor(
+            enabled = true,
+            senderOnly = false,
+            sender = snapshot.sender,
+            renderedThread = snapshot.renderedText,
+        ) ?: return
+        stopThreadReadAloud()
+        val session = tts ?: nexusTtsSession(threadReadAloudCallbacks)?.also { tts = it } ?: return
+        ttsGeneration += 1
+        val utteranceId = "thread-$ttsGeneration"
+        activeThreadUtteranceId = utteranceId
+        val result = session.speak(text, utteranceId)
+        if (result != NexusSdkResult.SENT && activeThreadUtteranceId == utteranceId) {
+            activeThreadUtteranceId = null
+        }
+    }
+
+    private var activeThreadUtteranceId: String? = null
+
+    private val threadReadAloudCallbacks = object : NexusTtsCallbacks {
+        override fun onTtsStarted(utteranceId: String) = Unit
+
+        override fun onTtsDone(utteranceId: String, reason: NexusTtsDoneReason) {
+            main.post {
+                if (utteranceId == activeThreadUtteranceId) activeThreadUtteranceId = null
+            }
+        }
+    }
+
+    private fun stopThreadReadAloud() {
+        if (activeThreadUtteranceId == null) return
+        activeThreadUtteranceId = null
+        tts?.stop()
+    }
+
+    private fun closeThreadReadAloud() {
+        stopThreadReadAloud()
+        tts?.close()
+        tts = null
+    }
+
     private fun refreshEntries() {
         entries = ReplyRepository.inboxEntries()
         selection.replaceItems(entries.map(RelayInboxEntry::id))
