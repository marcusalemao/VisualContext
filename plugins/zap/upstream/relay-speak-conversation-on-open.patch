+    /**
+     * Opening a conversation from the inbox speaks its newest message.
+     *
+     * The arriving band reads once and is gone in seconds; a voice note's
+     * transcript or a long message is often missed exactly then. Reopening the
+     * thread is the way to hear it again, with no new gesture: tap still
+     * replies, Back still returns. Off by default, like every voice output.
+     */
+    fun readThreadOnOpen(): Boolean =
+        prefs.getBoolean(KEY_READ_THREAD_ON_OPEN, DEFAULT_READ_THREAD_ON_OPEN)
+
+    fun setReadThreadOnOpen(enabled: Boolean) {
+        prefs.edit().putBoolean(KEY_READ_THREAD_ON_OPEN, enabled).apply()
+    }
